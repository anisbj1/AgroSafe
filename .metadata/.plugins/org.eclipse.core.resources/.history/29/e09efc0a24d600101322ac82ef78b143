#include "main.h"
#include <stdio.h>
#include <string.h>
#include <stdbool.h>          // Added: for bool type
#include "liquidcrystal_i2c.h"

/* Defines */
#define SOIL_DRY_THRESHOLD_PERCENT  40.0f
#define MAX_ALERTS                  5

typedef enum { ALERT_FLAMME = 1, ALERT_TEMP_HAUTE, ALERT_SOL_SEC } alert_type_t;

/* Variables */
uint16_t adc_buffer[2];           // [0] = Temp (PA6), [1] = Soil (PA7)
float current_temperature = 0.0f;
int status = 0;
int buzzer_on = 0;
int flame_buzzer = 0;
uint8_t flag = 0;

/* Alert log */
uint8_t alert_log[MAX_ALERTS] __attribute__((section(".ccmram")));
uint8_t alert_idx = 0;
uint8_t alert_cnt = 0;

/* USER CODE BEGIN 0 */
void Log_Alert(alert_type_t type)
{
    alert_log[alert_idx] = type;
    alert_idx = (alert_idx + 1) % MAX_ALERTS;
    if (alert_cnt < MAX_ALERTS) alert_cnt++;
}

void Show_Last_Two_Alerts(void)
{
    HD44780_Clear();
    if (alert_cnt == 0) {
        HD44780_SetCursor(0,0);
        HD44780_PrintStr(" SYSTEME OK ");
        return;
    }
    uint8_t last = (alert_idx == 0) ? MAX_ALERTS-1 : alert_idx-1;
    uint8_t prev = (last == 0) ? MAX_ALERTS-1 : last-1;

    const char* msg1 = "???";
    const char* msg2 = "???";

    switch(alert_log[last]) {
        case ALERT_FLAMME:     msg1 = "!!! FLAMME !!!"; break;
        case ALERT_TEMP_HAUTE: msg1 = "TEMP TROP HAUTE"; break;
        case ALERT_SOL_SEC:    msg1 = " !! SOL SEC !! "; break;
    }
    switch(alert_log[prev]) {
        case ALERT_FLAMME:     msg2 = "!!! FLAMME !!!"; break;
        case ALERT_TEMP_HAUTE: msg2 = "TEMP TROP HAUTE"; break;
        case ALERT_SOL_SEC:    msg2 = " !! SOL SEC !! "; break;
    }
    HD44780_SetCursor(0,0); HD44780_PrintStr(msg1);
    HD44780_SetCursor(0,1); HD44780_PrintStr(msg2);
}

void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    if (GPIO_Pin == Button_Pin) {
        status = !status;
        HD44780_Clear();
        HD44780_SetCursor(0,0); HD44780_PrintStr("SYSTEM");
        HD44780_SetCursor(0,1); HD44780_PrintStr(status ? "ON " : "OFF");
        HAL_GPIO_WritePin(GPIOD, Green_Pin, status ? GPIO_PIN_SET : GPIO_PIN_RESET);
    }

    if ((GPIO_Pin == GPIO_PIN_0) && status) {  // LDR
        if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0) == GPIO_PIN_RESET) {
            HD44780_Clear(); HD44780_PrintStr("Mode jour  ");
            HAL_GPIO_WritePin(GPIOD, Blue_Pin, GPIO_PIN_RESET);
        } else {
            HD44780_Clear(); HD44780_PrintStr("Mode nuit  ");
            HAL_GPIO_WritePin(GPIOD, Blue_Pin, GPIO_PIN_SET);
        }
    }

    if ((GPIO_Pin == Alert_Pin) && status) flag = 1;
}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM6) {
        HAL_ADC_Start_DMA(&hadc1, (uint32_t*)adc_buffer, 2);  // CRITICAL: Start DMA for 2 channels!
    }
    else if (htim->Instance == TIM7) {
        HAL_TIM_PWM_Stop(&htim1, TIM_CHANNEL_1);
        HAL_GPIO_WritePin(GPIOD, Blue_Pin|Orange_Pin|Red_Pin, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(GPIOE, Pompe_Pin|Ventilateur_Pin, GPIO_PIN_RESET);
        buzzer_on = flame_buzzer = 0;
    }
}

void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef* hadc)
{
    if (!status) return;

    float temp_v = (adc_buffer[0] * 3.3f) / 4095.0f;
    current_temperature = (temp_v - 0.76f) * 100.0f;  // LM35

    // Fixed the bug: was "adc_buffer[1_buffer[1]"
    float soil_percent = (1.0f - (adc_buffer[1] / 4095.0f)) * 100.0f;
    bool soil_dry = soil_percent < SOIL_DRY_THRESHOLD_PERCENT;
    bool flame = HAL_GPIO_ReadPin(Flame_GPIO_Port, Flame_Pin) == GPIO_PIN_RESET;

    char l1[17] = {0}, l2[17] = {0};

    if (flame) {
        snprintf(l1, 17, "!!! FLAMME !!!");
        snprintf(l2, 17, "ARRET SYSTEME");
        HAL_GPIO_WritePin(GPIOD, Red_Pin, GPIO_PIN_SET);
        HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
        buzzer_on = flame_buzzer = 1;
        Log_Alert(ALERT_FLAMME);
        HAL_TIM_Base_Start_IT(&htim7);
    }
    else if (soil_dry) {
        snprintf(l1, 17, "Sol sec %.0f%%", soil_percent);
        snprintf(l2, 17, "Pompe ON");
        HAL_GPIO_WritePin(GPIOD, Orange_Pin, GPIO_PIN_SET);
        HAL_GPIO_WritePin(GPIOE, Pompe_Pin, GPIO_PIN_SET);
        HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
        buzzer_on = 1;
        Log_Alert(ALERT_SOL_SEC);
        HAL_TIM_Base_Start_IT(&htim7);
    }
    else if (current_temperature > 35.0f) {
        snprintf(l1, 17, "TEMP: %.1fC", current_temperature);
        snprintf(l2, 17, "VENTILATEUR ON");
        HAL_GPIO_WritePin(GPIOD, Blue_Pin, GPIO_PIN_SET);
        HAL_GPIO_WritePin(GPIOE, Ventilateur_Pin, GPIO_PIN_SET);
        buzzer_on = 1;
        Log_Alert(ALERT_TEMP_HAUTE);
        HAL_TIM_Base_Start_IT(&htim7);
    }
    else {
        snprintf(l1, 17, "T:%.1fC H:%.0f%%", current_temperature, soil_percent);
        snprintf(l2, 17, "Systeme OK");
        HAL_GPIO_WritePin(GPIOD, Green_Pin, GPIO_PIN_SET);
    }

    HD44780_Clear();
    HD44780_SetCursor(0,0); HD44780_PrintStr(l1);
    HD44780_SetCursor(0,1); HD44780_PrintStr(l2);
}
/* USER CODE END 0 */

int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_DMA_Init();
    MX_I2C1_Init();
    MX_TIM1_Init();
    MX_TIM6_Init();
    MX_ADC1_Init();
    MX_TIM7_Init();

    HAL_TIM_Base_Start_IT(&htim6);  // Start ADC polling every 1s

    HD44780_Init(2);
    HD44780_Clear();
    HD44780_SetCursor(0,0);
    HD44780_PrintStr("Appuyer sur");
    HD44780_SetCursor(0,1);
    HD44780_PrintStr("le button");

    while (1)
    {
        if (flag) { flag = 0; Show_Last_Two_Alerts(); }

        // Visual feedback for Alert button
        HAL_GPIO_WritePin(GPIOD, Blue_Pin,
            (HAL_GPIO_ReadPin(GPIOC, Alert_Pin) == GPIO_PIN_RESET) ? GPIO_PIN_SET : GPIO_PIN_RESET);

        // Backup buzzer stop (TIM7 is main, this is safety)
        if (buzzer_on || flame_buzzer) {
            HAL_Delay(300);
            HAL_TIM_PWM_Stop(&htim1, TIM_CHANNEL_1);
            buzzer_on = flame_buzzer = 0;
        }
    }
}

