int main(void)
{
    HAL_Init();
    SystemClock_Config();

    MX_GPIO_Init();
    MX_DMA_Init();
    MX_I2C1_Init();
    MX_TIM1_Init();
    MX_TIM6_Init();
    MX_ADC1_Init();
    MX_TIM7_Init();

    /* USER CODE BEGIN 2 */
    HAL_TIM_Base_Start_IT(&htim6);  // Start ADC polling timer

    HD44780_Init(2);
    HD44780_Clear();
    HD44780_SetCursor(0,0);
    HD44780_PrintStr("Appuyer sur");
    HD44780_SetCursor(0,1);
    HD44780_PrintStr("le button");
    /* USER CODE END 2 */

    /* Infinite loop */
    while (1)
    {
        // Show last two alerts when button pressed
        if (flag == 1)
        {
            flag = 0;
            Show_Last_Two_Alerts();
        }

        // Optional: visual feedback on Alert_Pin
        HAL_GPIO_WritePin(GPIOD, Blue_Pin,
            (HAL_GPIO_ReadPin(GPIOC, Alert_Pin) == GPIO_PIN_RESET) ? GPIO_PIN_SET : GPIO_PIN_RESET);

        // Buzzer beep handling (backup if timer fails)
        if (buzzer_on || flame_buzzer)
        {
            HAL_Delay(300);
            HAL_TIM_PWM_Stop(&htim1, TIM_CHANNEL_1);
            buzzer_on = 0;
            flame_buzzer = 0;
        }
    }
}

