void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    if (GPIO_Pin == Button_Pin)
    {
        status = !status;
        if (status)
        {
            HAL_GPIO_WritePin(GPIOD, Green_Pin, GPIO_PIN_SET);
            HAL_GPIO_WritePin(GPIOD, Blue_Pin | Orange_Pin | Red_Pin, GPIO_PIN_RESET);
            HD44780_Clear();
            HD44780_SetCursor(0,0);
            HD44780_PrintStr("SYSTEM");
            HD44780_SetCursor(0,1);
            HD44780_PrintStr("ON");
        }
        else
        {
            HAL_GPIO_WritePin(GPIOD, Green_Pin | Blue_Pin | Orange_Pin | Red_Pin, GPIO_PIN_RESET);
            HD44780_Clear();
            HD44780_SetCursor(0,0);
            HD44780_PrintStr("SYSTEM");
            HD44780_SetCursor(0,1);
            HD44780_PrintStr("OFF");
        }
    }

    // LDR (day/night mode)
    if ((GPIO_Pin == GPIO_PIN_0) && status)
    {
        GPIO_PinState ldrState = HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0);
        if (ldrState != GPIO_PIN_SET) // light → day
        {
            currentMode = MODE_JOUR;
            HAL_GPIO_WritePin(GPIOD, Blue_Pin, GPIO_PIN_RESET);
            HD44780_Clear();
            HD44780_SetCursor(0,0);
            HD44780_PrintStr("Mode jour active");
            HD44780_SetCursor(0,1);
            HD44780_PrintStr("Lumiere forte");
        }
        else // dark → night
        {
            currentMode = MODE_NUIT;
            HAL_GPIO_WritePin(GPIOD, Blue_Pin, GPIO_PIN_SET);
            HD44780_Clear();
            HD44780_SetCursor(0,0);
            HD44780_PrintStr("Mode nuit active");
            HD44780_SetCursor(0,1);
            HD44780_PrintStr("Lumiere faible");
        }
    }

    // Alert button pressed
    if ((GPIO_Pin == Alert_Pin) && status)
    {
        flag = 1;
    }
}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM6)
    {
        HAL_ADC_Start_DMA(&hadc1, (uint32_t*)adc_buffer, 2); // 2 channels
    }
    else if (htim->Instance == TIM7)
    {
        // Auto-stop buzzer and actuators after ~3 seconds
        HAL_TIM_PWM_Stop(&htim1, TIM_CHANNEL_1);
        HAL_GPIO_WritePin(GPIOD, Blue_Pin | Orange_Pin | Red_Pin, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(GPIOE, Pompe_Pin | Ventilateur_Pin, GPIO_PIN_RESET);
        buzzer_on = 0;
        flame_buzzer = 0;
        HAL_TIM_Base_Stop_IT(&htim7);
    }
}

void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef* hadc)
{
    if (hadc->Instance == ADC1 && status)
    {
        uint16_t raw_temp = adc_buffer[0];  // Channel 6 (PA6)
        uint16_t raw_soil = adc_buffer[1];  // Channel 7 (PA7)

        float voltage_temp = (raw_temp * 3.3f) / 4095.0f;
        float current_temperature = (voltage_temp - 0.76f) * 100.0f; // LM35

        // Soil moisture sensor: higher voltage = drier soil
        float soil_moisture_percent = (1.0f - (raw_soil / 4095.0f)) * 100.0f;
        bool soil_is_dry = (soil_moisture_percent < SOIL_DRY_THRESHOLD_PERCENT);

        char line1[17] = {0};
        char line2[17] = {0};

        GPIO_PinState flame = HAL_GPIO_ReadPin(Flame_GPIO_Port, Flame_Pin);

        // === PRIORITY 1: FLAME ===
        if (flame == GPIO_PIN_RESET)
        {
            snprintf(line1, 17, "!!! FLAMME !!!");
            snprintf(line2, 17, "ARRET SYSTEME");
            HAL_GPIO_WritePin(GPIOD, Red_Pin, GPIO_PIN_SET);
            HAL_GPIO_WritePin(GPIOD, Green_Pin | Blue_Pin | Orange_Pin, GPIO_PIN_RESET);
            HAL_GPIO_WritePin(GPIOE, Pompe_Pin | Ventilateur_Pin, GPIO_PIN_RESET);
            HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
            buzzer_on = 1;
            flame_buzzer = 1;
            Log_Alert(ALERT_FLAMME);
            HAL_TIM_Base_Start_IT(&htim7);
        }
        // === PRIORITY 2: DRY SOIL ===
        else if (soil_is_dry)
        {
            snprintf(line1, 17, "Sol sec %.0f%%", soil_moisture_percent);
            snprintf(line2, 17, "Pompe active");
            HAL_GPIO_WritePin(GPIOD, Orange_Pin, GPIO_PIN_SET);
            HAL_GPIO_WritePin(GPIOD, Green_Pin | Blue_Pin | Red_Pin, GPIO_PIN_RESET);
            HAL_GPIO_WritePin(GPIOE, Pompe_Pin, GPIO_PIN_SET);
            HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
            buzzer_on = 1;
            Log_Alert(ALERT_SOL_SEC);
            HAL_TIM_Base_Start_IT(&htim7);
        }
        // === PRIORITY 3: HIGH TEMPERATURE ===
        else if (current_temperature > 35.0f)
        {
            snprintf(line1, 17, "TEMP: %.1fC", current_temperature);
            snprintf(line2, 17, "VENTILATEUR ON");
            HAL_GPIO_WritePin(GPIOD, Blue_Pin, GPIO_PIN_SET);
            HAL_GPIO_WritePin(GPIOE, Ventilateur_Pin, GPIO_PIN_SET);
            HAL_GPIO_WritePin(GPIOD, Orange_Pin | Red_Pin, GPIO_PIN_RESET);
            buzzer_on = 1;
            Log_Alert(ALERT_TEMP_HAUTE);
            HAL_TIM_Base_Start_IT(&htim7);
        }
        // === ALL OK ===
        else
        {
            snprintf(line1, 17, "T:%.1fC H:%.0f%%", current_temperature, soil_moisture_percent);
            snprintf(line2, 17, "Systeme OK");
            HAL_GPIO_WritePin(GPIOD, Green_Pin, GPIO_PIN_SET);
            HAL_GPIO_WritePin(GPIOD, Blue_Pin | Orange_Pin | Red_Pin, GPIO_PIN_RESET);
            HAL_GPIO_WritePin(GPIOE, Pompe_Pin | Ventilateur_Pin, GPIO_PIN_RESET);
        }

        HD44780_Clear();
        HD44780_SetCursor(0,0);
        HD44780_PrintStr(line1);
        HD44780_SetCursor(0,1);
        HD44780_PrintStr(line2);
    }
}
