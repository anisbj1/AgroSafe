int main(void)
{
    HAL_Init();
    SystemClock_Config();

    MX_GPIO_Init();
    MX_DMA_Init();
    MX_I2C1_Init();
    MX_TIM1_Init();
    MX_TIM6_Init();
    MX_ADC1_Init();
    MX_TIM7_Init();

    HAL_TIM_Base_Start_IT(&htim6);

    HD44780_Init(2);
    HD44780_Clear();
    HD44780_SetCursor(0,0);
    HD44780_PrintStr("Appuyer sur");
    HD44780_SetCursor(0,1);
    HD44780_PrintStr("le button");

    while (1)
    {
        if (flag == 1)
        {
            flag = 0;
            Show_Last_Two_Alerts();
        }

        // Optional visual feedback on Alert_Pin (you can remove if not needed)
        if (HAL_GPIO_ReadPin(GPIOC, Alert_Pin) == GPIO_PIN_RESET)
            HAL_GPIO_WritePin(GPIOD, Blue_Pin, GPIO_PIN_SET);
        else
            HAL_GPIO_WritePin(GPIOD, Blue_Pin, GPIO_PIN_RESET);

        // Buzzer short beep handling (already handled by TIM7 now, but kept for compatibility)
        if (buzzer_on || flame_buzzer)
        {
            HAL_Delay(200);
            HAL_TIM_PWM_Stop(&htim1, TIM_CHANNEL_1);
            buzzer_on = 0;
            flame_buzzer = 0;
        }
    }
}

