/* Remplace tout ton HAL_ADC_ConvCpltCallback par ça */
void HAL_ADC_ConvCpltCallback(ADC_HandleTypeDef* hadc)
{
    if (hadc->Instance == ADC1 && status)
    {
        uint16_t raw = HAL_ADC_GetValue(hadc);
        float voltage = (raw * 3.3f) / 4095.0f;        // LM35 alimenté en 5V
        current_temperature = voltage * 100.0f;        // 10 mV/°C

        // Lecture du capteur de flamme analogique sur PA10 (ADC1_IN10 ? à confirmer)
        uint16_t raw_flame;
        HAL_ADC_Start_DMA(&hadc1);
        HAL_ADC_PollForConversion(&hadc1, 10);
        raw_flame = HAL_ADC_GetValue(&hadc1);
        float flame_voltage = (raw_flame * 5.0f) / 4096.0f;

        char line1[17], line2[17];

        GPIO_PinState flame = HAL_GPIO_ReadPin(GPIOA, Flame_Pin);

        if (flame == GPIO_PIN_RESET)
        {
        //status=0;
        flame_buzzer=1;
        HD44780_Clear();
        HD44780_SetCursor(0,0);
        HD44780_PrintStr("Flamme detectee");
        HD44780_SetCursor(0,1);
        HD44780_PrintStr("Arret systeme");
        HAL_GPIO_WritePin(GPIOD, Red_Pin, GPIO_PIN_SET);
        HAL_TIM_PWM_Start(&htim1,TIM_CHANNEL_1);
        buzzer_on=1;
        AddAlert("Flamme");
        HAL_TIM_Base_Start_IT(&htim7);}
        // === PRIORITÉ 2 : TEMPÉRATURE ÉLEVÉE ===
        else if (current_temperature > 35.0f)
        {
            snprintf(line1, 17, "TEMP: %.1fC", current_temperature);
            snprintf(line2, 17, "VENTILATEUR ON");
            HAL_GPIO_WritePin(GPIOD, Blue_Pin, GPIO_PIN_SET);
            HAL_GPIO_WritePin(GPIOE, Ventilateur_Pin, GPIO_PIN_SET);
            HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
            buzzer_on = 1;
            AddAlert("Temp haute");
        }
        // === TOUT VA BIEN ===
        else
        {
            snprintf(line1, 17, "Temp: %.1fC", current_temperature);
            snprintf(line2, 17, "Systeme OK");
            HAL_GPIO_WritePin(GPIOD, Blue_Pin, GPIO_PIN_RESET);
            HAL_GPIO_WritePin(GPIOE, Ventilateur_Pin, GPIO_PIN_RESET);
        }

        HD44780_Clear();
        HD44780_SetCursor(0,0); HD44780_PrintStr(line1);
        HD44780_SetCursor(0,1); HD44780_PrintStr(line2);

        // Désactivation auto après 3 secondes
        HAL_TIM_Base_Start_IT(&htim7);
    }
}


