void HAL_GPIO_EXTI_Callback(uint16_t GPIO_Pin)
{
    if (GPIO_Pin == Button_Pin)
    {
        status = !status;

        if (status)
        {
            HAL_GPIO_WritePin(GPIOD, Green_Pin, GPIO_PIN_SET);
            HAL_GPIO_WritePin(GPIOD, Blue_Pin, GPIO_PIN_RESET);
            HAL_GPIO_WritePin(GPIOD, Orange_Pin, GPIO_PIN_RESET);
            HAL_GPIO_WritePin(GPIOD, Red_Pin, GPIO_PIN_RESET);
            HD44780_Clear();
            HD44780_SetCursor(0,0);
            HD44780_PrintStr("SYSTEM");
            HD44780_SetCursor(0,1);
            HD44780_PrintStr("ON");
        }
        else
        {
            HAL_GPIO_WritePin(GPIOD, Green_Pin, GPIO_PIN_RESET);
            HAL_GPIO_WritePin(GPIOD, Blue_Pin, GPIO_PIN_RESET);
            HAL_GPIO_WritePin(GPIOD, Orange_Pin, GPIO_PIN_RESET);
            HD44780_Clear();
            HD44780_SetCursor(0,0);
            HD44780_PrintStr("SYSTEM");
            HD44780_SetCursor(0,1);
            HD44780_PrintStr("OFF");
        }
    }

    if ((GPIO_Pin == GPIO_PIN_0) && status)
    {
        GPIO_PinState ldrState = HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0);

        if (ldrState != GPIO_PIN_SET)
        {
            currentMode = MODE_JOUR;
            HAL_GPIO_WritePin(GPIOD, Blue_Pin, GPIO_PIN_RESET);

            HD44780_Clear();
            HD44780_SetCursor(0,0);
            HD44780_PrintStr("Mode jour active");
            HD44780_SetCursor(0,1);
            HD44780_PrintStr("Lumiere forte");
        }
        else
        {
            currentMode = MODE_NUIT;
            HAL_GPIO_WritePin(GPIOD, Blue_Pin, GPIO_PIN_SET);

            HD44780_Clear();
            HD44780_SetCursor(0,0);
            HD44780_PrintStr("Mode nuit active");
            HD44780_SetCursor(0,1);
            HD44780_PrintStr("Lumiere faible");
        }
    }
    if((GPIO_Pin == Alert_Pin) && status)
    {
        static int test_scenario = 0;

        // Define test scenarios: {temperature, humidity, expected_risk}
        typedef struct {
            float temp;
            float hum;
            const char* name;
            int expected_risk;
        } TestScenario;

        TestScenario scenarios[] = {
            {20.0f, 80.0f, "Cool/Wet", 0},      // Should be SAFE
            {30.0f, 50.0f, "Warm/Med", 1},      // Should be WARNING
            {30.0f, 0.0f,  "Warm/Dry", 1},      // Your case - Warm & Very Dry
            {38.0f, 20.0f, "Hot/Dry", 2},       // Should be DANGER
            {40.0f, 10.0f, "V.Hot/V.Dry", 2},   // Definitely DANGER
        };

        int num_scenarios = sizeof(scenarios) / sizeof(scenarios[0]);

        // Get current scenario
        TestScenario current = scenarios[test_scenario];

        // ===== RUN AI =====
        ml_risk_level = predict_risk_level(current.temp, current.hum);

        // ===== DISPLAY =====
        HD44780_Clear();

        // Line 1: Scenario name and inputs
        char line1[17];
        snprintf(line1, 17, "%s", current.name);
        HD44780_SetCursor(0,0);
        HD44780_PrintStr(line1);

        // Line 2: Details and AI result
        char line2[17];
        snprintf(line2, 17, "%.1fC %.0f%% -> %d",
                 current.temp, current.hum, ml_risk_level);
        HD44780_SetCursor(0,1);
        HD44780_PrintStr(line2);

        // ===== CONTROL LEDS & BUZZER =====
        // Turn off all LEDs first
        HAL_GPIO_WritePin(GPIOD, Green_Pin | Orange_Pin | Red_Pin | Blue_Pin, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(GPIOE, Ventilateur_Pin, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(GPIOE, Pompe_Pin, GPIO_PIN_RESET);

        switch(ml_risk_level) {
            case 0: // Safe - Green LED
                HAL_GPIO_WritePin(GPIOD, Green_Pin, GPIO_PIN_SET);
                break;

            case 1: // Warning - Orange LED + beep
                HAL_GPIO_WritePin(GPIOD, Orange_Pin, GPIO_PIN_SET);
                HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
                buzzer_on = 1;

                // Optional: Activate fan if temp > 30
                if(current.temp > 30.0f) {
                    HAL_GPIO_WritePin(GPIOE, Ventilateur_Pin, GPIO_PIN_SET);
                    delay(1500);
                    HAL_GPIO_WritePin(GPIOE, Ventilateur_Pin, GPIO_PIN_RESET);


                }

                // Optional: Activate pump if very dry
                if(current.hum < 30.0f) {
                    HAL_GPIO_WritePin(GPIOE, Pompe_Pin, GPIO_PIN_SET);
                    delay(1500);
                    HAL_GPIO_WritePin(GPIOE, Pompe_Pin, GPIO_PIN_RESET);

                    HAL_GPIO_WritePin(GPIOD, Blue_Pin, GPIO_PIN_SET);
                }
                break;

            case 2: // Danger - Red LED + beep + fan
                HAL_GPIO_WritePin(GPIOD, Red_Pin, GPIO_PIN_SET);
                HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
                buzzer_on = 1;
                HAL_GPIO_WritePin(GPIOE, Ventilateur_Pin, GPIO_PIN_SET);
                delay(1500);
                HAL_GPIO_WritePin(GPIOE, Ventilateur_Pin, GPIO_PIN_RESET);


                // Also activate pump for very dry conditions
                if(current.hum < 40.0f) {
                    HAL_GPIO_WritePin(GPIOE, Pompe_Pin, GPIO_PIN_SET);
                    delay(1500);
                    HAL_GPIO_WritePin(GPIOE, Pompe_Pin, GPIO_PIN_RESET);

                    HAL_GPIO_WritePin(GPIOD, Blue_Pin, GPIO_PIN_SET);
                }
                break;
        }

        // ===== AUTO RESET AFTER 3 SECONDS =====
        HAL_TIM_Base_Start_IT(&htim7);

        // Move to next scenario
        test_scenario = (test_scenario + 1) % num_scenarios;

        // Clear the flag since we handled it
        flag = 0;
    }
}

void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM7)
    {
        // Turn off ALL outputs
        HAL_GPIO_WritePin(GPIOD, Green_Pin | Orange_Pin | Red_Pin | Blue_Pin, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(GPIOE, Pompe_Pin | Ventilateur_Pin, GPIO_PIN_RESET);

        // Stop buzzer
        HAL_TIM_PWM_Stop(&htim1, TIM_CHANNEL_1);
        buzzer_on = 0;

        // Stop this timer
        HAL_TIM_Base_Stop_IT(&htim7);

        // Show ready message
        HD44780_Clear();
        HD44780_SetCursor(0,0);
        HD44780_PrintStr("Press Alert");
        HD44780_SetCursor(0,1);
        HD44780_PrintStr("for next test");
    }
}
