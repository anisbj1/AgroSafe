volatile uint8_t i2c_dma_busy = 0;

void LCD_Print_DMA(const char* str)
{
    static uint8_t buffer[64];
    uint8_t* p = buffer;

    while (*str)
    {
        uint8_t c = *str++;
        *p++ = (c & 0xF0) | 0x0D;
        *p++ = (c & 0xF0) | 0x09;
        *p++ = (c << 4)   | 0x0D;
        *p++ = (c << 4)   | 0x09;
    }

    uint16_t len = p - buffer;
    if (len == 0) return;

    while (i2c_dma_busy);  // very rare

    HAL_I2C_Master_Transmit_DMA(&hi2c1, 0x4E, buffer, len);  // 0x27 << 1 = 0x4E
    i2c_dma_busy = 1;
}

// Called automatically by HAL when transmission finishes
void HAL_I2C_MasterTxCpltCallback(I2C_HandleTypeDef *hi2c)
{
    if (hi2c == &hi2c1)
        i2c_dma_busy = 0;
}
